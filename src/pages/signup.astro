---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Sign Up | AfriMigrate"
  description="Create your free AfriMigrate account to get a personalised country recommendation, save your progress, and build your migration plan."
>
  <div class="breadcrumb"><a href="/">Home</a> / Sign Up</div>
  <div class="auth-wrap">
    <div class="eyebrow">Free Account</div>
    <h1>Create your account</h1>
    <p class="lead" style="margin-bottom: 2rem;">Takes a minute. No credit card, ever, for the free tier.</p>

    <form id="signupForm" class="auth-card">
      <label class="crs-field">
        Email
        <input type="email" name="email" required class="crs-input" autocomplete="email" />
      </label>
      <label class="crs-field">
        Password
        <input type="password" name="password" required minlength="8" class="crs-input" autocomplete="new-password" />
      </label>
      <div id="authMessage" class="cp-note" hidden></div>
      <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; border: none; cursor: pointer;">Create account →</button>
    </form>
    <p class="lead" style="margin-top: 1.5rem; font-size: 0.9rem;">Already have an account? <a href="/login" style="color: var(--green); font-weight: 600;">Log in</a></p>
  </div>

  <style is:global>
    .auth-wrap { max-width: 440px; margin: 0 auto; text-align: center; }
    .auth-wrap h1 { font-size: 2rem; }
    .auth-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--rl); padding: 2rem; text-align: left; display: flex; flex-direction: column; gap: 1.25rem; }
  </style>

  <script>
    import { supabase, isSupabaseConfigured } from '../lib/supabase';

    const form = document.getElementById('signupForm') as HTMLFormElement;
    const message = document.getElementById('authMessage') as HTMLElement;

    function showMessage(text: string) {
      message.hidden = false;
      message.textContent = text;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!isSupabaseConfigured) {
        showMessage('⚠️ Accounts aren\'t switched on for this site yet — check back soon.');
        return;
      }
      const fd = new FormData(form);
      const email = fd.get('email') as string;
      const password = fd.get('password') as string;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating account…';

      const { error } = await supabase.auth.signUp({ email, password });
      if (error) {
        showMessage(`⚠️ ${error.message}`);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create account →';
        return;
      }
      window.location.href = '/onboarding';
    });
  </script>
</Layout>
