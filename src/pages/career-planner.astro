---
import Layout from '../layouts/Layout.astro';
import { canada } from '../data/countries/canada';
import { uk } from '../data/countries/uk';
import { australia } from '../data/countries/australia';
import { netherlands } from '../data/countries/netherlands';
import { belgium } from '../data/countries/belgium';
import { us } from '../data/countries/us';
import { fetchUnsplashPhoto } from '../lib/unsplash';

const countries = [canada, uk, australia, netherlands, belgium, us];

// One representative photo per country, fetched once at build time and
// embedded below — the client-side matching script just looks these up,
// it never calls Unsplash itself (see CLAUDE.md "Architecture — Unsplash").
const photosByCountry: Record<string, string | null> = {};
for (const c of countries) {
  const photo = await fetchUnsplashPhoto(`${c.areaGuide.city} skyline`);
  photosByCountry[c.slug] = photo?.url ?? null;
}

// Flattened, build-time dataset the client script searches against — no API
// calls happen when a visitor uses the planner, it's all baked in already.
const matchData = countries.map((c) => ({
  slug: c.slug,
  name: c.name,
  flag: c.flag,
  photo: photosByCountry[c.slug],
  careers: c.careerPathways.map((cp) => ({
    field: cp.field,
    roles: cp.inDemandRoles,
    salaryRange: cp.salaryRange,
    visaPathway: cp.visaPathway,
  })),
}));
---
<Layout
  title="Career Planner — Which Country Fits Your Profession? | AfriMigrate"
  description="Type your profession and see how it ranks for in-demand careers, salaries and visa pathways across Canada, the UK, Australia, Netherlands, Belgium and the US."
>
  <div class="breadcrumb"><a href="/">Home</a> / Career Planner</div>
  <div class="eyebrow">Free, Forever</div>
  <h1>Where does your career take you furthest?</h1>
  <p class="lead" style="margin-bottom: 2rem;">
    Type your profession or field below and see how it ranks for demand, salary and the visa route it typically qualifies for — across all six countries at once, not just one.
  </p>

  <div class="card" style="max-width: 640px; display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem;">
    <label class="crs-field" style="margin-bottom: 0;">
      Your profession or field
      <input id="careerInput" class="crs-input" type="text" placeholder="e.g. nurse, software engineer, electrician, teacher" autocomplete="off" />
    </label>
    <button id="careerSearchBtn" class="btn-primary" style="border: none; cursor: pointer; align-self: flex-start;">See my rankings →</button>
    <p style="font-size: 0.78rem; color: var(--ink2); margin-bottom: 0;">Try: nurse · software engineer · electrician · teacher · data scientist · welder</p>
  </div>

  <div id="careerResults"></div>

  <div id="careerEmpty" class="section" style="padding-top: 0;">
    <div class="eyebrow">Or Browse Everything</div>
    <h2>Every in-demand field, all six countries</h2>
    <div class="tools-grid">
      {countries.map((c) => (
        <div class="tool-card">
          <h3>{c.flag} {c.name}</h3>
          <div class="cp-tags">
            {c.careerPathways.map((cp) => <span class="cp-tag">{cp.field}</span>)}
          </div>
          <a href={`/${c.slug}#careers`} class="tool-link" style="margin-top: 1rem;">See full breakdown →</a>
        </div>
      ))}
    </div>
  </div>

  <script define:vars={{ matchData }}>
    const input = document.getElementById('careerInput');
    const btn = document.getElementById('careerSearchBtn');
    const results = document.getElementById('careerResults');
    const emptyState = document.getElementById('careerEmpty');

    function scoreCountry(country, query) {
      const q = query.trim().toLowerCase();
      if (!q) return { score: 0, matches: [] };
      let score = 0;
      const matches = [];
      for (const career of country.careers) {
        let careerScore = 0;
        for (const role of career.roles) {
          const roleLower = role.toLowerCase();
          if (roleLower === q) careerScore = Math.max(careerScore, 3);
          else if (roleLower.includes(q) || q.includes(roleLower)) careerScore = Math.max(careerScore, 2);
        }
        if (career.field.toLowerCase().includes(q)) careerScore = Math.max(careerScore, 1);
        if (careerScore > 0) {
          score += careerScore;
          matches.push({ ...career, careerScore });
        }
      }
      return { score, matches };
    }

    function render(query) {
      const ranked = matchData
        .map((c) => ({ country: c, ...scoreCountry(c, query) }))
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score);

      if (ranked.length === 0) {
        results.innerHTML = `<div class="cp-note" style="max-width: 640px;">No exact match for "${query}" — try a broader term (e.g. "nurse" instead of a specific specialty), or browse every field below.</div>`;
        emptyState.hidden = false;
        return;
      }

      emptyState.hidden = true;
      results.innerHTML = `
        <div class="eyebrow">Ranked For You</div>
        <h2 style="margin-bottom: 1.5rem;">Best fits for "${query}"</h2>
        <div class="tools-grid" style="margin-bottom: 2.5rem;">
          ${ranked.map((r, i) => `
            <div class="tool-card">
              ${r.country.photo ? `<img src="${r.country.photo}" alt="${r.country.name}" style="width: calc(100% + 4.5rem); height: 160px; object-fit: cover; margin: -2.25rem -2.25rem 1.25rem; border-radius: var(--radius-lg) var(--radius-lg) 0 0; display: block;" loading="lazy" />` : ''}
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <span style="font-size: 1.5rem;">${r.country.flag}</span>
                <h3 style="margin-bottom: 0;">#${i + 1}: ${r.country.name}</h3>
              </div>
              ${r.matches.map((m) => `
                <div style="border-top: 1px solid var(--border); padding-top: 0.85rem; margin-top: 0.85rem;">
                  <p style="font-weight: 600; color: var(--ink); margin-bottom: 0.35rem; font-size: 0.9rem;">${m.field}</p>
                  <p style="font-size: 0.82rem; color: var(--ink2); margin-bottom: 0.25rem;"><strong style="color: var(--ink);">Salary:</strong> ${m.salaryRange}</p>
                  <p style="font-size: 0.82rem; color: var(--ink2); margin-bottom: 0;"><strong style="color: var(--ink);">Visa route:</strong> ${m.visaPathway}</p>
                </div>
              `).join('')}
              <a href="/${r.country.slug}#careers" class="tool-link" style="margin-top: 1rem;">See full ${r.country.name} profile →</a>
            </div>
          `).join('')}
        </div>
      `;
    }

    function runSearch() {
      const query = input.value;
      if (!query.trim()) {
        results.innerHTML = '';
        emptyState.hidden = false;
        return;
      }
      render(query);
    }

    btn.addEventListener('click', runSearch);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') runSearch(); });
  </script>
</Layout>
