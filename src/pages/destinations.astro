---
import Layout from '../layouts/Layout.astro';
import { canada } from '../data/countries/canada';
import { uk } from '../data/countries/uk';
import { australia } from '../data/countries/australia';
import { netherlands } from '../data/countries/netherlands';
import { belgium } from '../data/countries/belgium';
import { us } from '../data/countries/us';
import { fetchUnsplashPhoto } from '../lib/unsplash';

const destCountries = [canada, uk, australia, netherlands, belgium, us];
const destPhotos = await Promise.all(
  destCountries.map((c) => fetchUnsplashPhoto(`${c.areaGuide.city} skyline`))
);
const heroPhoto = await fetchUnsplashPhoto('africa world map travel');
---
<Layout
  title="Best Country for Africans to Migrate To | AfriMigrate"
  description="Explore all six migration destinations AfriMigrate covers for Africans — Canada, UK, Australia, Netherlands, Belgium and the United States — with every legal visa route."
>
  <div class="breadcrumb"><a href="/">Home</a> / Destinations</div>
  <div class="eyebrow">Destinations</div>
  <h1>Where do you want to go?</h1>
  <p class="lead" style="margin-bottom: 1.5rem;">
    There's no single "best" country — it depends on your profession, savings, and whether you already have a job offer. Here's an honest look at every destination AfriMigrate covers.
  </p>

  {heroPhoto && (
    <div class="page-hero-photo-wrap">
      <img src={heroPhoto.url} alt={heroPhoto.alt} class="page-hero-photo" width="1200" height="360" />
      <a href={heroPhoto.creditUrl} target="_blank" rel="noopener" class="photo-credit">Photo: {heroPhoto.creditName} / Unsplash</a>
    </div>
  )}

  <section class="section">
    <div class="tools-grid">
      {[
        { c: canada, hot: true, desc: 'The most transparent points-based system. No job offer needed for Express Entry, and 11 provinces run their own nominee programs.', label: 'Explore Canada →' },
        { c: uk, desc: 'Sponsor-led system best for professionals in healthcare, IT, engineering and education who can secure a licensed sponsor.', label: 'Explore the UK →' },
        { c: australia, desc: 'Skills-first, points-tested system with no job offer required for the main independent visa.', label: 'Explore Australia →' },
        { c: netherlands, desc: "One of Europe's fastest work-permit systems, with a genuinely useful tax break for skilled migrants.", label: 'Explore the Netherlands →' },
        { c: belgium, desc: 'Real, current shortages in IT and healthcare, with regional shortage-occupation exemptions that skip the labour market test.', label: 'Explore Belgium →' },
        { c: us, desc: 'Highly competitive employer routes, but also home to the free Diversity Visa lottery — open to almost every African country.', label: 'Explore the USA →' },
      ].map((item, i) => (
        <div class="tool-card">
          {item.hot && <div class="hot">Most popular</div>}
          {destPhotos[i] ? (
            <div class="tool-card-photo-wrap">
              <img src={destPhotos[i]!.url} alt={destPhotos[i]!.alt} class="tool-card-photo" loading="lazy" width="400" height="150" />
              <a href={destPhotos[i]!.creditUrl} target="_blank" rel="noopener" class="photo-credit photo-credit-mini">Photo: {destPhotos[i]!.creditName}</a>
            </div>
          ) : (
            <div class="tool-icon">{item.c.flag}</div>
          )}
          <h3>{item.c.slug === 'us' ? 'United States' : item.c.name}</h3>
          <p>{item.desc}</p>
          <a href={`/${item.c.slug}`} class="tool-link">{item.label}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">Not Sure Yet?</div>
    <h2>Compare them side by side</h2>
    <p class="lead">See cost, timeline, and job offer requirements across our top destinations in one table.</p>
    <a href="/compare" class="btn-primary" style="margin-top: 1rem;">Compare destinations →</a>
  </section>
</Layout>
