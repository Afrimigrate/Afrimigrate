---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout
  title="Dashboard | AfriMigrate"
  description="Your personalised AfriMigrate dashboard — recommended country, CRS score, migration timeline, and document vault."
>
  <div id="dashboardGate" class="lead" style="text-align: center; padding: 4rem 0;">Loading your dashboard…</div>

  <div id="dashboardRoot" hidden>
    <div class="dash-header">
      <div>
        <div class="eyebrow">Your Dashboard</div>
        <h1 id="dashGreeting">Welcome back</h1>
        <span id="dashPremiumBadge" class="hot" style="position: static; display: none; margin-top: 0.5rem;">✓ Premium</span>
      </div>
      <button id="logoutBtn" class="btn-ghost" style="background: none; border: none; cursor: pointer;">Log out</button>
    </div>

    <section class="section" style="padding-top: 1.5rem;">
      <div class="card dash-readiness">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <h3 style="margin-bottom: 0;">Migration readiness</h3>
          <span id="readinessPct" style="font-family: 'Newsreader', serif; font-weight: 700; font-size: 1.4rem; color: var(--green);">0%</span>
        </div>
        <div class="crs-progress-bar"><div class="crs-progress-fill" id="readinessFill" style="width: 0%;"></div></div>
        <p style="font-size: 0.8rem; color: var(--ink2); margin-top: 0.75rem; margin-bottom: 0;">Based on your profile, documents, and timeline progress — this will get more accurate as later features ship.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 0.5rem;">
      <div class="tools-grid">
        <div class="tool-card">
          <div class="tool-icon"><Icon name="target" /></div>
          <h3>Recommended pathway</h3>
          <p id="dashRecommendation">Not taken yet.</p>
          <a id="dashRecommendationLink" href="/quiz" class="tool-link">Take the quiz →</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon"><Icon name="calculator" /></div>
          <h3>CRS score</h3>
          <p id="dashCrs">Not calculated yet.</p>
          <a href="/canada/crs-calculator" class="tool-link">Calculate now →</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon"><Icon name="calendar" /></div>
          <h3>Migration timeline</h3>
          <p>Your staged, month-by-month plan with due dates for every milestone.</p>
          <a href="/timeline" class="tool-link">Open your timeline →</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon"><Icon name="lock" /></div>
          <h3>Document vault</h3>
          <p>Securely store your passport, language certs and degree certificates, with expiry tracking.</p>
          <a href="/vault" class="tool-link">Open your vault →</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon"><Icon name="bell" /></div>
          <h3>Reminders</h3>
          <p id="dashReminders">Due dates from your timeline show up here as they approach.</p>
          <a href="/timeline" class="tool-link">See what's due →</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon"><Icon name="check" /></div>
          <h3>UK sponsorship tracker</h3>
          <p>Search licensed sponsors and track the applications you've sent.</p>
          <a href="/uk/sponsorship-tracker" class="tool-link">Open tracker →</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon"><Icon name="trophy" /></div>
          <h3>Badges</h3>
          <p id="dashBadges">None earned yet.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="card">
        <h3>Your profile</h3>
        <div id="dashProfile" class="cp-route-grid" style="margin-top: 1rem;"></div>
      </div>
    </section>
  </div>

  <style is:global>
    .dash-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; }
    .dash-readiness { max-width: 100%; }
    .dash-soon .tool-icon { color: var(--ink2); opacity: 0.6; }
  </style>

  <script>
    import { supabase, isSupabaseConfigured } from '../lib/supabase';

    const gate = document.getElementById('dashboardGate') as HTMLElement;
    const root = document.getElementById('dashboardRoot') as HTMLElement;

    async function init() {
      if (!isSupabaseConfigured) {
        gate.textContent = '⚠️ Accounts aren\'t switched on for this site yet — check back soon.';
        return;
      }
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const { data: profile, error } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', session.user.id)
        .maybeSingle();

      if (error) {
        gate.textContent = `⚠️ Couldn't load your dashboard: ${error.message}`;
        return;
      }

      if (!profile || !profile.onboarding_completed_at) {
        window.location.href = '/onboarding';
        return;
      }

      gate.hidden = true;
      root.hidden = false;
      const baseReadiness = render(profile);
      loadReminders(session.user.id);
      addProgressReadiness(session.user.id, baseReadiness);

      document.getElementById('logoutBtn')!.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/';
      });
    }

    async function loadReminders(userId: string) {
      const in14Days = new Date();
      in14Days.setDate(in14Days.getDate() + 14);
      const { data: due } = await supabase
        .from('timeline_milestones')
        .select('title, due_date')
        .eq('user_id', userId)
        .eq('completed', false)
        .lte('due_date', in14Days.toISOString().slice(0, 10))
        .order('due_date', { ascending: true });

      const el = document.getElementById('dashReminders')!;
      if (!due || due.length === 0) return;
      const overdue = due.filter((d: any) => new Date(d.due_date) < new Date());
      if (overdue.length > 0) {
        el.textContent = `${overdue.length} overdue — next: "${overdue[0].title}"`;
      } else {
        el.textContent = `${due.length} due in the next 14 days — next: "${due[0].title}"`;
      }
    }

    function render(profile: Record<string, any>) {
      document.getElementById('dashGreeting')!.textContent = `Welcome, ${profile.full_name || 'there'}`;

      if (profile.is_premium) {
        (document.getElementById('dashPremiumBadge') as HTMLElement).style.display = 'inline-block';
      }

      if (profile.recommended_country) {
        document.getElementById('dashRecommendation')!.textContent =
          `${profile.recommended_country} — ${profile.recommendation_reasoning || ''}`;
        document.getElementById('dashRecommendationLink')!.textContent = 'Retake the quiz →';
      }
      if (profile.crs_score) {
        document.getElementById('dashCrs')!.textContent = `${profile.crs_score} / 1,200`;
      }

      // Readiness: 20% onboarding + 15% pathway confirmed + 10% CRS scored +
      // up to 25% documents uploaded (5 docs = full) + up to 30% timeline
      // milestones completed. Each piece only counts once its feature is
      // actually used, so this is a real measure of progress, not a guess.
      let readiness = profile.onboarding_completed_at ? 20 : 0;
      if (profile.recommended_country) readiness += 15;
      if (profile.crs_score) readiness += 10;
      document.getElementById('readinessPct')!.textContent = `${readiness}%`;
      (document.getElementById('readinessFill') as HTMLElement).style.width = `${readiness}%`;

      const fields: [string, string][] = [
        ['Location', profile.current_location],
        ['Education', profile.education_level],
        ['Career field', profile.career_field],
        ['Language ability', profile.language_ability],
        ['Timeline', profile.timeline_urgency],
        ['Country interest', profile.country_interest || 'Not sure yet'],
      ];
      document.getElementById('dashProfile')!.innerHTML = fields
        .map(([label, value]) => `<div><span class="cp-route-label">${label}</span><p>${value ?? '—'}</p></div>`)
        .join('');

      return readiness;
    }

    async function addProgressReadiness(userId: string, base: number) {
      const [{ count: docCount }, { data: milestones }] = await Promise.all([
        supabase.from('documents').select('id', { count: 'exact', head: true }).eq('user_id', userId),
        supabase.from('timeline_milestones').select('completed').eq('user_id', userId),
      ]);

      const docScore = Math.min(25, Math.round(((docCount || 0) / 5) * 25));
      let timelineScore = 0;
      if (milestones && milestones.length > 0) {
        const done = milestones.filter((m: any) => m.completed).length;
        timelineScore = Math.round((done / milestones.length) * 30);
      }
      const total = Math.min(100, base + docScore + timelineScore);
      document.getElementById('readinessPct')!.textContent = `${total}%`;
      (document.getElementById('readinessFill') as HTMLElement).style.width = `${total}%`;
    }

    init();
  </script>
</Layout>
