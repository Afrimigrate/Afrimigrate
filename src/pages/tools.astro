---
import Layout from '../layouts/Layout.astro';
import { fetchUnsplashPhoto } from '../lib/unsplash';

const heroPhoto = await fetchUnsplashPhoto('person using laptop calculator desk');
---
<Layout
  title="Free Immigration Tools for Africans | AfriMigrate"
  description="Every free AfriMigrate tool in one place: CRS calculator, PNP finder, UK visa checker, Australia points calculator, document checklists, and more."
>
  <div class="breadcrumb"><a href="/">Home</a> / Tools</div>
  <div class="eyebrow">All Tools</div>
  <h1>Every free tool, in one place</h1>
  <p class="lead" style="margin-bottom: 1.5rem;">
    No paywalls, no upsells, no "unlock the full report" screens. Every tool below is 100% free, forever.
  </p>

  {heroPhoto && (
    <div class="page-hero-photo-wrap">
      <img src={heroPhoto.url} alt={heroPhoto.alt} class="page-hero-photo" width="1200" height="360" />
      <a href={heroPhoto.creditUrl} target="_blank" rel="noopener" class="photo-credit">Photo: {heroPhoto.creditName} / Unsplash</a>
    </div>
  )}

  <section class="section" style="padding-top: 0;">
    <div class="tool-card" style="max-width: 100%;">
      <div class="hot">Not sure where to start?</div>
      <h3>🧭 Find My Best Country</h3>
      <p>Answer 5 quick questions and get a ranked recommendation across all six countries, with real reasoning — before diving into any one country's tools below.</p>
      <a href="/quiz" class="tool-link">Take the free quiz →</a>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">Canada</div>
    <h2>🇨🇦 Canada tools</h2>
    <div class="tools-grid">
      <div class="tool-card"><div class="hot">Most used</div><div class="tool-icon">🧮</div><h3>CRS Calculator</h3><p>Score yourself for Express Entry in minutes.</p><a href="/canada/crs-calculator" class="tool-link">Open →</a></div>
      <div class="tool-card"><div class="tool-icon">🗺️</div><h3>PNP Finder</h3><p>Find which Provincial Nominee Program fits you.</p><a href="/canada/pnp" class="tool-link">Open →</a></div>
      <div class="tool-card"><div class="tool-icon">📋</div><h3>Document Checklist</h3><p>Everything you need to gather, in one list.</p><a href="/canada/document-checklist" class="tool-link">Open →</a></div>
      <div class="tool-card"><div class="tool-icon">💰</div><h3>Cost of Moving</h3><p>A realistic breakdown of fees and settlement funds.</p><a href="/canada/cost-of-moving" class="tool-link">Open →</a></div>
      <div class="tool-card"><div class="tool-icon">⏱️</div><h3>PR Timeline Estimator</h3><p>See how long your pathway is likely to take.</p><a href="/canada/pr-timeline" class="tool-link">Open →</a></div>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">United Kingdom</div>
    <h2>🇬🇧 UK tools</h2>
    <div class="tools-grid">
      <div class="tool-card"><div class="tool-icon">✅</div><h3>Skilled Worker Visa Checker</h3><p>Check your core eligibility in two minutes.</p><a href="/uk/skilled-worker-visa-checker" class="tool-link">Open →</a></div>
      <div class="tool-card"><div class="tool-icon">💷</div><h3>Visa Cost Calculator</h3><p>Estimate application fees and the IHS.</p><a href="/uk/visa-cost-calculator" class="tool-link">Open →</a></div>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">Australia</div>
    <h2>🇦🇺 Australia tools</h2>
    <div class="tools-grid">
      <div class="tool-card"><div class="tool-icon">🧮</div><h3>Points Calculator</h3><p>Estimate your subclass 189/190 points score.</p><a href="/australia/points-calculator" class="tool-link">Open →</a></div>
      <div class="tool-card"><div class="tool-icon">🎓</div><h3>Skills Assessment Guide</h3><p>Find your occupation's assessing body.</p><a href="/australia/skills-assessment" class="tool-link">Open →</a></div>
    </div>
  </section>
</Layout>
