---
export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <meta name="theme-color" content="#2E8B2E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <slot name="head" />
  <style is:global>
    :root {
      --bg:        #F7F4EF;
      --bg2:       #EDEAE3;
      --ink:       #141210;
      --ink2:      #5C564E;
      --green:     #2E8B2E;
      --green-mid: #3da03d;
      --gold:      #C8960E;
      --gold-bg:   #FBF3DC;
      --border:    #DDD8CF;
      --white:     #FFFFFF;
      --r:         10px;
      --rl:        18px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(247,244,239,0.92); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 0 5vw; height: 62px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo { font-family: 'Fraunces', serif; font-weight: 900; font-size: 1.25rem; color: var(--ink); letter-spacing: -0.3px; }
    .logo span { color: var(--green); }
    .nav-links { display: flex; gap: 2rem; list-style: none; font-size: 0.875rem; font-weight: 500; color: var(--ink2); }
    .nav-links a:hover { color: var(--ink); }
    .nav-cta { background: var(--ink); color: var(--white); padding: 0.55rem 1.35rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; transition: opacity 0.2s; }
    .nav-cta:hover { opacity: 0.8; }

    main { max-width: 1160px; margin: 0 auto; padding: 4rem 5vw; }
    h1, h2, h3 { font-family: 'Fraunces', serif; font-weight: 900; color: var(--ink); }
    h1 { font-size: clamp(2.4rem, 4.5vw, 3.4rem); letter-spacing: -1.5px; line-height: 1.05; margin-bottom: 1.25rem; }
    h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -0.6px; line-height: 1.15; margin-bottom: 1rem; }
    h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
    p { font-weight: 300; }
    .eyebrow { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.85rem; }
    .lead { font-size: 1rem; color: var(--ink2); line-height: 1.8; font-weight: 300; max-width: 560px; }

    .btn-primary {
      background: var(--green); color: var(--white); padding: 0.875rem 2rem; border-radius: 999px;
      font-weight: 600; font-size: 0.95rem; transition: opacity 0.2s, transform 0.15s;
      display: inline-flex; align-items: center; gap: 0.4rem;
    }
    .btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-ghost {
      color: var(--ink2); font-size: 0.9rem; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;
      border-bottom: 1px solid var(--border); padding-bottom: 2px; transition: color 0.2s, border-color 0.2s;
    }
    .btn-ghost:hover { color: var(--ink); border-color: var(--ink2); }

    /* CARDS / TOOLS */
    .tools-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
    .tool-card {
      background: var(--white); border: 1px solid var(--border); border-radius: var(--rl); padding: 2.25rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; position: relative;
    }
    .tool-card:hover { border-color: #bbb8b0; transform: translateY(-3px); box-shadow: 0 8px 28px rgba(20,18,16,0.07); }
    .tool-icon {
      width: 48px; height: 48px; background: var(--bg); border: 1px solid var(--border); border-radius: 12px;
      display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 1.25rem;
    }
    .tool-card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; letter-spacing: -0.2px; }
    .tool-card p { font-size: 0.875rem; color: var(--ink2); line-height: 1.7; font-weight: 300; margin-bottom: 1.5rem; }
    .tool-link { font-size: 0.82rem; font-weight: 600; color: var(--green); display: inline-flex; align-items: center; gap: 0.25rem; }
    .tool-link:hover { text-decoration: underline; }
    .tool-link.muted { color: var(--ink2); }
    .hot {
      position: absolute; top: 1.5rem; right: 1.5rem; background: var(--gold-bg); color: var(--gold);
      font-size: 0.65rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid rgba(200,150,14,0.2);
    }

    /* GENERIC SECTIONS */
    .section { padding: 4rem 0; }
    .section-alt { background: var(--white); }
    .card {
      background: var(--white); border: 1px solid var(--border); border-radius: var(--rl); padding: 2rem;
    }

    /* STEPS */
    .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 3rem; position: relative; }
    .steps::before { content: ''; position: absolute; top: 27px; left: calc(12.5% + 12px); right: calc(12.5% + 12px); height: 1px; background: var(--border); }
    .step { text-align: center; padding: 0 1rem; }
    .step-icon {
      width: 54px; height: 54px; border-radius: 50%; background: var(--white); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin: 0 auto 1.25rem;
      position: relative; z-index: 1; transition: border-color 0.2s, box-shadow 0.2s;
    }
    .step:hover .step-icon { border-color: var(--green); box-shadow: 0 0 0 4px rgba(46,139,46,0.07); }
    .step h3 { font-size: 1rem; margin-bottom: 0.4rem; }
    .step p { font-size: 0.82rem; color: var(--ink2); line-height: 1.65; font-weight: 300; }

    /* MARQUEE */
    .marquee-wrap { background: var(--ink); padding: 0.7rem 0; overflow: hidden; margin: 0 calc(-5vw); }
    .marquee-track {
      display: inline-flex; gap: 3rem; white-space: nowrap; animation: marquee 24s linear infinite;
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.45);
    }
    .marquee-item { display: inline-flex; align-items: center; gap: 0.6rem; }
    .marquee-item b { color: rgba(255,255,255,0.85); }
    .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* WAITLIST */
    .waitlist-section { background: var(--ink); border-radius: var(--rl); text-align: center; padding: 4rem 2rem; }
    .waitlist-section .eyebrow { color: var(--gold); }
    .waitlist-section h2 { color: var(--white); }
    .waitlist-section p { color: rgba(247,244,239,0.55); font-size: 1rem; font-weight: 300; line-height: 1.8; margin: 0 auto 2rem; max-width: 480px; }
    .waitlist-form {
      display: flex; gap: 0.75rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 999px; padding: 0.35rem 0.35rem 0.35rem 1.5rem; max-width: 480px; margin: 0 auto;
    }
    .waitlist-form input { flex: 1; background: transparent; border: none; outline: none; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; color: var(--white); font-weight: 300; }
    .waitlist-form input::placeholder { color: rgba(255,255,255,0.35); }
    .waitlist-form button {
      background: var(--green); color: var(--white); border: none; padding: 0.75rem 1.5rem; border-radius: 999px;
      font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: opacity 0.2s; white-space: nowrap;
    }
    .waitlist-form button:hover { opacity: 0.85; }
    .waitlist-note { margin-top: 1rem; font-size: 0.78rem; color: rgba(247,244,239,0.3); }
    .waitlist-success {
      display: none; background: rgba(46,139,46,0.15); border: 1px solid rgba(46,139,46,0.3); color: #7bc97b;
      padding: 1rem 1.5rem; border-radius: var(--r); font-size: 0.9rem; font-weight: 500; max-width: 480px; margin: 0 auto;
    }

    /* DESTINATIONS */
    .dest-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; margin-top: 2.5rem; }
    .dest-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--rl); padding: 1.75rem 1rem; text-align: center; transition: border-color 0.2s, transform 0.2s; }
    .dest-card.live:hover { border-color: var(--green); transform: translateY(-3px); }
    .dest-card a { display: block; }
    .dest-flag { font-size: 2rem; margin-bottom: 0.6rem; }
    .dest-name { font-family: 'Fraunces', serif; font-weight: 700; font-size: 0.9rem; color: var(--ink); margin-bottom: 0.5rem; }
    .live-pip { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.68rem; font-weight: 600; color: var(--green); }
    .live-pip::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--green); animation: blink 2.2s ease-in-out infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
    .soon-pip { font-size: 0.68rem; color: var(--ink2); opacity: 0.6; }

    /* MANIFESTO */
    .manifesto { background: var(--green); border-radius: var(--rl); padding: 4rem 2rem; text-align: center; position: relative; overflow: hidden; }
    .manifesto h2 { color: var(--white); }
    .manifesto h2 em { font-style: italic; }
    .manifesto p { color: rgba(255,255,255,0.75); font-size: 1.05rem; font-weight: 300; line-height: 1.85; max-width: 540px; margin: 1.25rem auto 0; position: relative; z-index: 1; }

    /* TABLES */
    table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
    th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
    th { font-weight: 600; color: var(--ink); background: var(--bg2); }
    td { color: var(--ink2); font-weight: 300; }

    /* FAQ */
    .faq-item { border-bottom: 1px solid var(--border); padding: 1.5rem 0; }
    .faq-item h3 { font-size: 1.05rem; margin-bottom: 0.5rem; }
    .faq-item p { color: var(--ink2); font-size: 0.92rem; }

    /* BADGE */
    .badge { display: inline-flex; align-items: center; gap: 0.5rem; background: #EEF7EE; border: 1px solid #C3DEC3; color: var(--green); font-size: 0.85rem; font-weight: 600; padding: 0.6rem 1rem; border-radius: var(--r); }

    /* IFRAME TOOL EMBED */
    .tool-embed { width: 100%; min-height: 800px; border: 1px solid var(--border); border-radius: var(--rl); }

    /* BREADCRUMB */
    .breadcrumb { font-size: 0.8rem; color: var(--ink2); margin-bottom: 1.5rem; }
    .breadcrumb a { color: var(--ink2); }
    .breadcrumb a:hover { color: var(--green); }

    /* FOOTER */
    footer { background: var(--bg2); border-top: 1px solid var(--border); padding: 3.5rem 5vw 2.5rem; }
    .footer-inner { max-width: 1160px; margin: 0 auto; }
    .footer-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
    .footer-logo { font-family: 'Fraunces', serif; font-weight: 900; font-size: 1.2rem; color: var(--ink); margin-bottom: 0.5rem; }
    .footer-logo span { color: var(--green); }
    .footer-tagline { font-size: 0.85rem; color: var(--ink2); font-weight: 300; max-width: 220px; line-height: 1.6; }
    .footer-col h4 { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink2); margin-bottom: 1rem; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
    .footer-col a { font-size: 0.875rem; color: var(--ink2); font-weight: 300; transition: color 0.2s; }
    .footer-col a:hover { color: var(--ink); }
    .footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 2rem; font-size: 0.78rem; color: var(--ink2); flex-wrap: wrap; gap: 1rem; }

    /* REVEAL */
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.in { opacity: 1; transform: none; }

    @media (max-width: 900px) {
      .nav-links { display: none; }
      .tools-grid { grid-template-columns: 1fr; }
      .steps { grid-template-columns: 1fr 1fr; }
      .steps::before { display: none; }
      .dest-grid { grid-template-columns: repeat(3,1fr); }
    }
    @media (max-width: 560px) {
      main { padding: 2.5rem 5vw; }
      .dest-grid { grid-template-columns: repeat(2,1fr); }
      .steps { grid-template-columns: 1fr; }
      .footer-top { flex-direction: column; }
      .waitlist-form { flex-direction: column; border-radius: var(--rl); padding: 1rem; }
      .waitlist-form button { border-radius: var(--r); }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none; }
      .live-pip::before { animation: none; }
    }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="logo">Afri<span>Migrate</span></a>
    <ul class="nav-links">
      <li><a href="/tools">Tools</a></li>
      <li><a href="/how-it-works">How it works</a></li>
      <li><a href="/destinations">Destinations</a></li>
      <li><a href="/blog">Guides</a></li>
    </ul>
    <a href="/canada/crs-calculator" class="nav-cta">Start free →</a>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <div class="footer-top">
        <div>
          <div class="footer-logo">Afri<span>Migrate</span></div>
          <p class="footer-tagline">Free migration planning for Africans moving to Canada, UK, Australia and beyond.</p>
        </div>
        <div class="footer-col">
          <h4>Destinations</h4>
          <ul>
            <li><a href="/canada">Canada</a></li>
            <li><a href="/uk">United Kingdom</a></li>
            <li><a href="/australia">Australia</a></li>
            <li><a href="/compare">Compare destinations</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Tools</h4>
          <ul>
            <li><a href="/canada/crs-calculator">CRS Calculator</a></li>
            <li><a href="/uk/skilled-worker-visa-checker">UK Visa Checker</a></li>
            <li><a href="/australia/points-calculator">Australia Points Calculator</a></li>
            <li><a href="/tools">All tools</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/blog">Guides</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="https://instagram.com/afrimigrate.app" target="_blank" rel="noopener">Instagram</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <ul>
            <li><a href="/privacy-policy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 AfriMigrate · Free migration planning for Africans</span>
        <span>Made with ♥ for the African diaspora</span>
      </div>
    </div>
  </footer>
</body>
</html>
