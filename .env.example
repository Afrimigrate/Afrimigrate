# Copy this file's contents into your Vercel project's Environment Variables
# (Project Settings -> Environment Variables). Never commit real values —
# .env is already in .gitignore.

# From the Stripe Dashboard -> Developers -> API keys (use the "Secret key")
STRIPE_SECRET_KEY=sk_live_...

# From the Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...

# From the Stripe Dashboard -> Product catalog -> each product's Price ID
STRIPE_PRICE_PDF_REPORT=price_...
STRIPE_PRICE_AI_COVER_LETTER=price_...

# Your live site URL, used to build Stripe redirect links
PUBLIC_SITE_URL=https://afrimigrate.com

# --- Supabase (accounts, database, document vault) ---
# From the Supabase Dashboard -> Project Settings -> API -> "Project URL"
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# From the same page -> "anon public" key. Safe to expose to the browser —
# NEVER use the "service_role" key here, that one must stay server-only.
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Unsplash (real tourist attraction photos) ---
# From unsplash.com/developers -> Your Apps -> New Application -> "Access Key"
PUBLIC_UNSPLASH_ACCESS_KEY=...

# --- Google Places API (live ratings/hours for tourist sites + "Find Your
# Community": African grocery stores, churches, mosques, community centres) ---
# Setup, in Google Cloud Console (console.cloud.google.com):
#   1. Create a project (or pick an existing one).
#   2. IMPORTANT: unlike Supabase/Unsplash, Google requires a billing account
#      attached to the project before Places API will work at all, even
#      though normal usage for this site stays within the free monthly
#      credit. Add a card under Billing before continuing.
#   3. APIs & Services -> Library -> search "Places API (New)" -> Enable.
#   4. APIs & Services -> Credentials -> Create Credentials -> API key.
#   5. Click the new key -> under "Application restrictions" choose
#      "Websites" and add afrimigrate.com (and localhost for testing).
#      This key is NOT safe to leave unrestricted, unlike Supabase's anon
#      key -- without this step anyone could copy it and run up your bill.
#   6. Paste the restricted key below / into Vercel.
# Until this is set, the tourist "See live rating & hours" button and the
# whole /community page show a friendly "not switched on yet" message
# instead of breaking.
PUBLIC_GOOGLE_PLACES_API_KEY=...
